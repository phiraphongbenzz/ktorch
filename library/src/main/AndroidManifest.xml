<?xml version="1.0" encoding="utf-8"?>
<!-- No <uses-permission>: nothing from this library adds a permission to the host app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Own task affinity: the inspector shows up as a separate entry in Recents. -->
        <activity
            android:name=".internal.ui.InspectorActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="false"
            android:icon="@mipmap/ktorch_ic_launcher"
            android:label="@string/ktorch_name"
            android:roundIcon="@mipmap/ktorch_ic_launcher_round"
            android:launchMode="singleTask"
            android:taskAffinity="${applicationId}.ktorch"
            android:theme="@style/ktorch_Theme"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name=".internal.share.KtorchFileProvider"
            android:authorities="${applicationId}.ktorch.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/ktorch_file_paths" />
        </provider>

        <!-- Captures the application context at startup (see KtorchInitializer). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.phiraphongbenzz.ktorch.internal.KtorchInitializer"
                android:value="androidx.startup" />
        </provider>
    </application>

</manifest>
