<?xml version="1.0" encoding="utf-8"?>
<!-- Inspector icon (Recents). Named with the ktorch_ prefix so it never replaces the host app's ic_launcher. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ktorch_ic_launcher_background" />
    <foreground android:drawable="@drawable/ktorch_ic_launcher_foreground" />
    <!-- Themed icons (Android 13+) tint this layer. -->
    <monochrome android:drawable="@drawable/ktorch_ic_launcher_foreground" />
</adaptive-icon>
